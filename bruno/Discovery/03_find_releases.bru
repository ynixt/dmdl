meta {
  name: Find releases
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/discovery/releases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
{
  "identity": {
    "sourceId": "{{metadataSourceId}}",
    "sourceRevision": 1,
    "resourceType": "movie",
    "contentId": "{{contentId}}"
  },
  "category": "MOVIE",
  "title": "Example",
  "year": 2024
}
}
