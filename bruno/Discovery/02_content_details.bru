meta {
  name: Content metadata
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/discovery/meta?kind=movie&contentId={{contentId}}&forceRefresh=false
  body: none
  auth: inherit
}

params:query {
  kind: movie
  contentId: {{contentId}}
  forceRefresh: false
}

tests {
  test("Returns current movie metadata", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().identity.resourceType).to.equal("movie");
    expect(res.getBody().title).to.be.a("string");
  });
}
